# Copy to .env (docker compose) and .env.local (Next.js), then fill in.

# .env
POSTGRES_PASSWORD=change-me

# .env.local
DATABASE_URL=postgres://docsku:change-me@127.0.0.1:5491/docsku
CRON_SECRET=generate-a-long-random-string
UPLOAD_DIR=./storage/uploads
# Optional: extra hostnames allowed to use the dev server (comma-separated).
# DEV_ORIGINS=docs.example.test
# Encrypts secrets saved from the dashboard (AI API key). Generate once: openssl rand -hex 32
ENCRYPTION_KEY=generate-a-64-char-hex-string
# Optional: AI API key from the environment instead of the dashboard (takes precedence).
# AI_API_KEY=
# Public address of the site, e.g. https://docs.example.com (used for social preview images).
# SITE_URL=
# Set to 1 only behind a reverse proxy (Caddy, Nginx) that sets X-Forwarded-For/-Host/-Proto.
# Without it those headers come from the client and are ignored (login limits are then per account).
# TRUST_PROXY=1
# Optional: where the built-in scheduler calls /api/internal/publish-scheduled (default: this server's PORT).
# SCHEDULER_URL=http://127.0.0.1:3010
# Optional: update check (Pengaturan → Pembaruan). GitHub repository with releases, and a read-only
# token for a private one; both can also be set in the dashboard. The env token takes precedence.
# UPDATE_REPO=teknik-github/DocsKu
# UPDATE_GITHUB_TOKEN=
