{
  "name": "docsku",
  "version": "0.4.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed/run.mts",
    "db:studio": "drizzle-kit studio",
    "prod:deploy": "sh deploy/deploy.sh",
    "release": "sh deploy/release.sh",
    "backup": "sh deploy/backup.sh",
    "restore": "sh deploy/restore.sh",
    "prod:logs": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production logs -f app",
    "prod:stop": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production stop app"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
