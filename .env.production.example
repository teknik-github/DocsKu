# Copy to .env.production and fill in. Used by docker-compose.prod.yml and deploy/deploy.sh.

# Public address of the site, as visitors open it (your reverse proxy serves HTTPS).
SITE_URL=https://docs.example.com

# Same values as the dev setup, so the existing database and saved AI key keep working:
# POSTGRES_PASSWORD from .env (letters and digits only, it goes into a URL), the rest from .env.local.
POSTGRES_PASSWORD=change-me
CRON_SECRET=generate-a-long-random-string
ENCRYPTION_KEY=generate-a-64-char-hex-string
# AI_API_KEY=

# Where the app listens on this host, for the reverse proxy (default 127.0.0.1:3020).
# Keep it on 127.0.0.1: the app trusts X-Forwarded-* headers, so only the proxy may reach it.
# APP_PORT=3020
# APP_BIND=127.0.0.1
# Behind Cloudflare: read visitors' IPs from CF-Connecting-IP (for rate limits). Only when the origin
# accepts traffic from Cloudflare alone (firewall to Cloudflare's IP ranges, or a Cloudflare Tunnel).
# TRUST_PROXY=cloudflare

# Which image to run: built by GitHub for each release (pnpm release X.Y.Z). Default: the newest.
# Pin a version to stay on it or to roll back. A private repository needs `docker login ghcr.io` once.
# DOCSKU_VERSION=latest
# DOCSKU_IMAGE=ghcr.io/teknik-github/docsku
